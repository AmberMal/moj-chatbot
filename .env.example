# Skopiuj te nazwy do pliku .env.local i wpisz po znaku = swoje wartości.
# Nie wpisuj tu prawdziwego klucza – ten plik trafia do Gita.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=
# Supabase – tylko serwer (klucz secret omija RLS; podpisy historii rozmowy).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Lekcja 7: Supabase Auth – adres projektu i klucz publishable (sb_publishable_…), mogą trafić do przeglądarki.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
